{
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "types": [
      "bun"
    ],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "strict": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@module-sample/*": [
        "./src/*"
      ],
      "@workflows/*": [
        "./src/workflows/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "module.config.ts"
  ]
}